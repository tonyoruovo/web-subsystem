{
  "name": "@webkrnl/platform",
  "version": "0.1.0-rc.2",
  "description": "The orchestrator of WebKrnl: one call that boots a chosen set of subsystems, wired together.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@webkrnl/analytics": "workspace:*",
    "@webkrnl/auth": "workspace:*",
    "@webkrnl/consent": "workspace:*",
    "@webkrnl/core": "workspace:*",
    "@webkrnl/crypto": "workspace:*",
    "@webkrnl/design-system": "workspace:*",
    "@webkrnl/global-state": "workspace:*",
    "@webkrnl/hub": "workspace:*",
    "@webkrnl/logger": "workspace:*",
    "@webkrnl/network": "workspace:*",
    "@webkrnl/notification": "workspace:*",
    "@webkrnl/queue": "workspace:*",
    "@webkrnl/realtime": "workspace:*",
    "@webkrnl/settings": "workspace:*",
    "@webkrnl/storage": "workspace:*",
    "@webkrnl/sync": "workspace:*",
    "@webkrnl/translation": "workspace:*"
  },
  "devDependencies": {},
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "author": "MathAid",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyoruovo/WebKrnl.git",
    "directory": "packages/platform"
  },
  "homepage": "https://github.com/tonyoruovo/WebKrnl/tree/master/packages/platform#readme",
  "bugs": {
    "url": "https://github.com/tonyoruovo/WebKrnl/issues"
  }
}
