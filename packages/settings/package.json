{
  "name": "@webkrnl/settings",
  "version": "0.1.0-rc.1",
  "description": "The Settings subsystem: the preferences of the user and of the device, shared by every tab of the site.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@webkrnl/core": "workspace:*"
  },
  "devDependencies": {
    "@webkrnl/consent": "workspace:*",
    "@webkrnl/core": "workspace:*",
    "@webkrnl/hub": "workspace:*",
    "@webkrnl/notification": "workspace:*",
    "@webkrnl/queue": "workspace:*"
  },
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "author": "MathAid",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyoruovo/WebKrnl.git",
    "directory": "packages/settings"
  },
  "homepage": "https://github.com/tonyoruovo/WebKrnl/tree/master/packages/settings#readme",
  "bugs": {
    "url": "https://github.com/tonyoruovo/WebKrnl/issues"
  }
}
