    "vue-router": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@webkrnl/core": "workspace:*",
    "@webkrnl/platform": "workspace:*",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
