{
  "name": "@webkrnl/core",
  "version": "0.1.0-rc.1",
  "description": "The kernel of the platform: units, lifecycle, dependencies, state, views, packets and scopes.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./worker": "./src/processor/worker.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "sideEffects": false,
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      },
      "./worker": {
        "types": "./dist/processor/worker.d.ts",
        "import": "./dist/processor/worker.js"
      },
      "./fixtures/*": "./fixtures/*"
    },
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "author": "MathAid",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyoruovo/WebKrnl.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tonyoruovo/WebKrnl/tree/master/packages/core#readme",
  "bugs": {
    "url": "https://github.com/tonyoruovo/WebKrnl/issues"
  }
}
