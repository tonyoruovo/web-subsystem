{
  "name": "@webkrnl/create",
  "version": "0.1.0-rc.2",
  "description": "The scaffolder of WebKrnl: npm init @webkrnl writes a Vue or plain TypeScript app.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "create-webkrnl": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "templates"
  ],
  "sideEffects": false,
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public",
    "registry": "https://npm.pkg.github.com",
    "bin": {
      "create-webkrnl": "./dist/cli.js"
    }
  },
  "author": "MathAid",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyoruovo/WebKrnl.git",
    "directory": "packages/create"
  },
  "homepage": "https://github.com/tonyoruovo/WebKrnl/tree/master/packages/create#readme",
  "bugs": {
    "url": "https://github.com/tonyoruovo/WebKrnl/issues"
  }
}
