      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "author": "MathAid",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyoruovo/WebKrnl.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/tonyoruovo/WebKrnl/tree/master/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/tonyoruovo/WebKrnl/issues"
  }
