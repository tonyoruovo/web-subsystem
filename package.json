{
  "name": "web-subsystem",
  "version": "0.0.1",
  "description": "A library for building web subsystems with TypeScript.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,json,html,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc"
  },
  "keywords": [
    "web",
    "subsystem",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.7.0",
    "eslint-plugin-import": "^2.32.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
