{
  "name": "@webkrnl/translation",
  "version": "0.1.0-rc.1",
  "description": "The Translation subsystem: ICU messages, the locale chain, offline catalogs and locale-aware formatting.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/compile.worker.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@webkrnl/core": "workspace:*"
  },
  "devDependencies": {
    "@webkrnl/consent": "workspace:*",
    "@webkrnl/core": "workspace:*",
    "@webkrnl/network": "workspace:*",
    "@webkrnl/notification": "workspace:*",
    "@webkrnl/queue": "workspace:*",
    "@webkrnl/settings": "workspace:*",
    "@webkrnl/storage": "workspace:*"
  },
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/compile.worker.d.ts",
        "import": "./dist/compile.worker.js"
      }
    },
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "author": "MathAid",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyoruovo/WebKrnl.git",
    "directory": "packages/translation"
  },
  "homepage": "https://github.com/tonyoruovo/WebKrnl/tree/master/packages/translation#readme",
  "bugs": {
    "url": "https://github.com/tonyoruovo/WebKrnl/issues"
  }
}
