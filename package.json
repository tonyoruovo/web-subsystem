{
  "name": "web-subsystem",
  "version": "0.0.2",
  "private": true,
  "description": "A library for building web subsystems with TypeScript.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,html,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project node --coverage",
    "check:browsers": "node scripts/check-browsers.ts",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:docs && pnpm check:examples && pnpm test",
    "docs": "typedoc",
    "check:docs": "node scripts/check-docs.ts",
    "check:examples": "node scripts/check-examples.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:docs"
  },
  "keywords": [
    "web",
    "subsystem",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "browserslist": "^4.29.3",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.5",
    "rolldown": "1.2.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "lodash": "^4.18.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
